{
    "model": {
        "base_model": "Qwen/Qwen3-0.6B",
        "teacher_model": "Qwen/Qwen3-4B",
        "is_do_alignment": false,
        "alignment_strategy": "first",
        "include_response": false,
        "projector": {
            "type": "C2CComplexProjector",
            "params": {
                "hidden_dim": 1024,
                "intermediate_dim": 1024,
                "num_layers": 3,
                "fusion_num_layers": 2,
                "weight_num_layers": 1,
                "dropout": 0.1,
                "activation": "gelu",
                "use_layer_norm": true,
                "use_swiglu": false,
                "initial_temperature": 1.0,
                "final_temperature": 0.001,
                "anneal_steps": 1929,
                "scalar_temperature": 1.0,
                "use_checkpoint": true
            }
        },
        "mapping": "last_aligned"
    },
    "training": {
        "learning_rate": 1e-4,
        "weight_decay": 0.01,
        "num_epochs": 1,
        "max_length": 2048,
        "device": "cuda",
        "scheduler_type": "linear",
        "warmup_ratio": 0.1,
        "max_grad_norm": 1.0,
        "gradient_accumulation_steps": 32,
        "per_device_train_batch_size": 1,
        "num_processes": 8,
        "freeze": ["teacher", "base"],
        "seed": 42
    },
    "output": {
        "output_dir": "local/checkpoints/qwen3_0.6b_qwen3_4b_C2C_C_openhermes_500k",
        "save_steps": 500,
        "eval_steps": 100,
        "wandb_config": {
            "project": "C2C",
            "mode": "disabled",
            "entity": "june6-hanyang-university",
            "run_name": "qwen3_0.6b_qwen3_4b_C2C_C_openhermes_500k"
        }
    },
    "data": {
        "type": "OpenHermesChatDataset",
        "kwargs": {
            "split": "train",
            "max_word_count": 2048,
            "num_samples": 500000,
            "cache_dir": "local/hf_datasets_cache/openhermes_c2c_c_qwen3_0_6b_qwen3_4b_500k"
        },
        "train_ratio": 0.99
    }
}
